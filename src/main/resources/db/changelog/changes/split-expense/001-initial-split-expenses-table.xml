<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-split-expenses-tables" author="rohit">
        <createTable tableName="expense_groups">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_expense_groups"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement tableName="expense_groups" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1"/>

        <addForeignKeyConstraint baseTableName="expense_groups" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_expense_groups_on_users"/>

        <createTable tableName="group_members">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_group_members"/>
            </column>
            <column name="group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="joined_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement tableName="group_members" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1"/>

        <addForeignKeyConstraint baseTableName="group_members" baseColumnNames="group_id"
                                 referencedTableName="expense_groups" referencedColumnNames="id"
                                 constraintName="fk_group_members_on_expense_groups"/>

        <addForeignKeyConstraint baseTableName="group_members" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_group_members_on_users"/>

        <createTable tableName="split_expenses">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_split_expenses"/>
            </column>
            <column name="group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="paid_by_user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(255)"/>
            <column name="expense_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement tableName="split_expenses" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1"/>

        <addForeignKeyConstraint baseTableName="split_expenses" baseColumnNames="group_id"
                                 referencedTableName="expense_groups" referencedColumnNames="id"
                                 constraintName="fk_split_expenses_on_expense_groups"/>

        <addForeignKeyConstraint baseTableName="split_expenses" baseColumnNames="paid_by_user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_split_expenses_on_users"/>

        <createTable tableName="split_expense_shares">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_split_expense_shares"/>
            </column>
            <column name="split_expense_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement tableName="split_expense_shares" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1"/>

        <addForeignKeyConstraint baseTableName="split_expense_shares" baseColumnNames="split_expense_id"
                                 referencedTableName="split_expenses" referencedColumnNames="id"
                                 constraintName="fk_split_expense_shares_on_split_expenses"/>

        <addForeignKeyConstraint baseTableName="split_expense_shares" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_split_expense_shares_on_users"/>

        <createTable tableName="settlements">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_settlements"/>
            </column>
            <column name="group_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="paid_by_user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="paid_to_user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="settlement_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addAutoIncrement tableName="settlements" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1"/>

        <addForeignKeyConstraint baseTableName="settlements" baseColumnNames="group_id"
                                 referencedTableName="expense_groups" referencedColumnNames="id"
                                 constraintName="fk_settlements_on_expense_groups"/>

        <addForeignKeyConstraint baseTableName="settlements" baseColumnNames="paid_by_user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_settlements_on_users_paid_by"/>

        <addForeignKeyConstraint baseTableName="settlements" baseColumnNames="paid_to_user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_settlements_on_users_paid_to"/>
    </changeSet>

</databaseChangeLog>
